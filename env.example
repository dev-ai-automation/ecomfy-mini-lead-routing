# Copy this file to .env  ->  cp env.example .env
# Postgres connection. Inside docker-compose use host "db"; locally use "localhost".
DATABASE_URL=postgresql+psycopg2://ecomfy:ecomfy@localhost:5432/ecomfy

# Optional: AI executive summary (Parte 9). If empty, the summary degrades gracefully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: real Slack alerts (Parte 8). If empty, alerts are logged to console + DB.
SLACK_WEBHOOK_URL=

# Simulated buyer timeout threshold (seconds).
BUYER_TIMEOUT_SECONDS=2.0
